# このファイルを .env にコピーして値を設定してください
# DATABASE_URL: mysql://ユーザー:パスワード@ホスト:ポート/DB名
DATABASE_URL="mysql://wr_app:CHANGE_ME@127.0.0.1:3306/weekly_report"

# セッション暗号化キー(32文字以上のランダム文字列)
SESSION_SECRET="CHANGE_ME_TO_RANDOM_48_CHARS"

# HTTPS運用時に 1 を設定する(セッションCookieをHTTPS接続でのみ送信する)
# 本番(https://wrsys.coolied.com)では 1 を設定している
COOKIE_SECURE=1
